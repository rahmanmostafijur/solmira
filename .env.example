# Overrides for docker-compose.yml. Copy to .env to change them; every value has a dev default.
# Service-level settings live in apps/<service>/.env (see apps/<service>/.env.example).

POSTGRES_PASSWORD=solmira_dev_password
SERVICE_DB_PASSWORD=solmira_service_dev_password
RABBITMQ_PASSWORD=solmira_dev_password
MINIO_ROOT_USER=solmira
MINIO_ROOT_PASSWORD=solmira_dev_minio_password
S3_BUCKET=solmira-media

POSTGRES_PORT=5433
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
GATEWAY_PORT=8080
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
