{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["vitest.service.config.ts"]
    },
    "apps/*-service": {
      "entry": [
        "src/main.ts",
        "src/database/migrate.ts",
        "scripts/*.mjs",
        "src/**/*.test.ts",
        "test/**/*.test.ts"
      ]
    },
    "packages/service-kit": {
      "entry": ["src/index.ts", "src/testing/index.ts", "src/**/*.test.ts", "test/**/*.ts"],
      "ignoreDependencies": ["pino-pretty"]
    },
    "packages/contracts": {
      "entry": ["src/**/*.test.ts"]
    },
    "apps/dispatcher": {
      "entry": [
        "src/main.ts",
        "src/database/migrate.ts",
        "scripts/*.mjs",
        "src/**/*.test.ts",
        "test/**/*.test.ts"
      ]
    },
    "packages/webhooks": {
      "entry": ["src/**/*.test.ts", "examples/**/*.ts"]
    },
    "tests/resilience": {
      "entry": ["chaos/**/*.chaos.test.ts", "load/run.ts", "load/sweep.ts", "scripts/*.mjs"]
    },
    "packages/telemetry": {
      "entry": ["src/index.ts", "src/testing.ts", "src/**/*.test.ts"]
    }
  }
}
