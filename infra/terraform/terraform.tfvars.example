# Copy to production.tfvars and fill in. Nothing here is a secret.
region             = "eu-west-1"
account_id         = "123456789012"
availability_zones = ["eu-west-1a", "eu-west-1b", "eu-west-1c"]

domain_name     = "app.example.com"
route53_zone_id = "Z0123456789ABCDEFGHIJ"

# Tag of the images in ECR (a git commit). Tags are immutable.
image_tag = "0000000"

# Mail: a Secrets Manager secret holding the SMTP URL, and a verified sender.
smtp_url_secret_arn = "arn:aws:secretsmanager:eu-west-1:123456789012:secret:solmira/smtp-AbCdEf"
mail_from           = "Solmira <no-reply@example.com>"

alarm_email = "oncall@example.com"
