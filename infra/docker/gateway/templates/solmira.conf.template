# Rendered by the nginx image's envsubst step: ${NAME} placeholders are replaced with environment
# variables at container start. Lower-case $variables are nginx runtime variables and are left alone.

map $internal_service $internal_upstream {
  identity     ${IDENTITY_UPSTREAM};
  ingest       ${INGEST_UPSTREAM};
  notification ${NOTIFICATION_UPSTREAM};
  analytics    ${ANALYTICS_UPSTREAM};
  audit        ${AUDIT_UPSTREAM};
  dispatcher   ${DISPATCHER_UPSTREAM};
}

server {
  listen 80 default_server;
  proxy_read_timeout 60s;

  # Variables (rather than static upstream blocks) make nginx resolve hosts per request.
  set $web          ${WEB_UPSTREAM};
  set $identity     ${IDENTITY_UPSTREAM};
  set $ingest       ${INGEST_UPSTREAM};
  set $notification ${NOTIFICATION_UPSTREAM};
  set $analytics    ${ANALYTICS_UPSTREAM};
  set $audit        ${AUDIT_UPSTREAM};
  set $dispatcher   ${DISPATCHER_UPSTREAM};

  # Declared at server level only: any add_header inside a location would drop all of these.
  add_header X-Request-Id $request_id always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  # HSTS is added at the TLS edge (CloudFront / ALB), not on this plain-HTTP hop.

  error_page 429 = @rate_limited;
  error_page 502 503 504 = @upstream_unavailable;

  location = /gateway/health {
    access_log off;
    default_type application/json;
    return 200 '{"status":"ok"}';
  }

  # ---- identity-service -------------------------------------------------------------------
  # Credential endpoints get a much stricter per-IP budget (brute force, credential stuffing).
  location ~ ^/api/v1/auth/(login|register|forgot-password|reset-password)$ {
    limit_req zone=auth_per_ip burst=5 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://$identity;
  }

  # Checks the current password, so it is a credential endpoint too.
  location = /api/v1/me/password {
    limit_req zone=auth_per_ip burst=5 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://$identity;
  }

  location ~ ^/api/v1/(auth|me|organizations|users|roles|permissions|invitations)(/|$) {
    limit_req zone=api_per_ip burst=60 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://$identity;
  }

  # ---- ingest-service ---------------------------------------------------------------------
  location ~ ^/api/v1/(applications|event-types)(/|$) {
    limit_req zone=api_per_ip burst=60 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://$ingest;
  }

  # ---- notification-service ---------------------------------------------------------------
  location ~ ^/api/v1/notifications(/|$) {
    limit_req zone=api_per_ip burst=60 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://$notification;
  }

  location /ws/ {
    include /etc/nginx/snippets/proxy.conf;
    proxy_read_timeout 1h;
    proxy_pass http://$notification;
  }

  # ---- analytics-service ------------------------------------------------------------------
  location ~ ^/api/v1/analytics(/|$) {
    limit_req zone=api_per_ip burst=60 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://$analytics;
  }

  location = /graphql {
    limit_req zone=api_per_ip burst=60 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://$analytics;
  }

  # ---- audit-service ----------------------------------------------------------------------
  location ~ ^/api/v1/audit-logs(/|$) {
    limit_req zone=api_per_ip burst=60 nodelay;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://$audit;
  }

  # ---- internal: readiness and API docs, private networks only ----------------------------
  location ~ ^/internal/health/(?<internal_service>identity|ingest|dispatcher|notification|analytics|audit)$ {
    allow 127.0.0.1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://$internal_upstream/health/ready;
  }

  location ~ ^/internal/docs/(?<internal_service>identity|ingest|dispatcher|notification|analytics|audit)(?<docs_path>/.*)?$ {
    allow 127.0.0.1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://$internal_upstream/docs$docs_path$is_args$args;
  }

  # Unknown API paths never fall through to the web app.
  location ~ ^/api/ {
    default_type application/json;
    return 404 '{"error":{"code":"NOT_FOUND","message":"No API route matches this path","requestId":"$request_id"}}';
  }

  # ---- web --------------------------------------------------------------------------------
  location / {
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://$web;
  }

  location @rate_limited {
    default_type application/json;
    return 429 '{"error":{"code":"RATE_LIMITED","message":"Too many requests, slow down","requestId":"$request_id"}}';
  }

  location @upstream_unavailable {
    default_type application/json;
    return 503 '{"error":{"code":"SERVICE_UNAVAILABLE","message":"The service is temporarily unavailable","requestId":"$request_id"}}';
  }
}
