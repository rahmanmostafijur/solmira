# Copy to .env for local development (loaded by `pnpm dev`). Values match docker-compose.yml defaults.
NODE_ENV=development
PORT=4006
LOG_LEVEL=info
LOG_PRETTY=true

# The dispatcher connects to the ingest database as its own role (ADR-0031).
DATABASE_URL=postgres://dispatcher_app:solmira_service_dev_password@localhost:5433/solmira_ingest

# Must be the same key ingest-service encrypts signing secrets with (local development only).
SECRETS_ENCRYPTION_KEY=jwQOFPGSgMYBdzcMS4iBQfZGKQY8Iwi1LU+DxYyoREc=
SECRETS_ENCRYPTION_KEY_ID=local-1

# Attempt history. DynamoDB Local in development; in AWS leave the endpoint unset.
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE=solmira-delivery-attempts
DYNAMODB_CREATE_TABLE=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Development only: allow http and private targets so a local receiver works (refused in production).
ALLOW_PRIVATE_ENDPOINT_TARGETS=false
