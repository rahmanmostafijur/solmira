# Copy to .env for local development (loaded by `pnpm dev`). Values match docker-compose.yml defaults.
# DynamoDB (event history) settings are added in phase 10.
NODE_ENV=development
PORT=4005
LOG_LEVEL=info
LOG_PRETTY=true
