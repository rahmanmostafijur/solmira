# Copy to .env for local development (loaded by `pnpm dev`). Values match docker-compose.yml defaults.
NODE_ENV=development
PORT=4002
LOG_LEVEL=info
LOG_PRETTY=true

# Runtime role: subject to row-level security. Migrations use the separate schema owner below.
DATABASE_URL=postgres://ingest_app:solmira_service_dev_password@localhost:5433/solmira_ingest
MIGRATION_DATABASE_URL=postgres://ingest_owner:solmira_service_dev_password@localhost:5433/solmira_ingest
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://solmira:solmira_dev_password@localhost:5672

# Access tokens are issued by identity-service and verified here with its public JWKS only.
IDENTITY_JWKS_URL=http://localhost:4001/api/v1/auth/.well-known/jwks.json
JWT_ISSUER=solmira-identity
JWT_AUDIENCE=solmira-api
ACCESS_TOKEN_TTL_SECONDS=900

# Key-encryption key for webhook signing secrets: 32 random bytes, base64 (openssl rand -base64 32).
# This value is for local development only; AWS KMS replaces it in deployed environments.
SECRETS_ENCRYPTION_KEY=jwQOFPGSgMYBdzcMS4iBQfZGKQY8Iwi1LU+DxYyoREc=
SECRETS_ENCRYPTION_KEY_ID=local-1

# Development only: allow http endpoints and private or loopback targets (refused in production).
ALLOW_PRIVATE_ENDPOINT_TARGETS=false

# Ingestion (all optional; the values shown are the defaults).
# MAX_MESSAGE_PAYLOAD_BYTES=262144
# IDEMPOTENCY_RETENTION_SECONDS=86400
# INGEST_RATE_LIMIT_PER_MINUTE=600
# OUTBOX_RETENTION_DAYS=7
# OUTBOX_RELAY_BATCH_SIZE=100
# OUTBOX_RELAY_POLL_MS=500
