# Copy to .env for local development (loaded by `pnpm dev`). Values match docker-compose.yml defaults.
NODE_ENV=development
PORT=4001
LOG_LEVEL=info
LOG_PRETTY=true
DATABASE_URL=postgres://identity_app:solmira_service_dev_password@localhost:5433/solmira_identity
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://solmira:solmira_dev_password@localhost:5672
