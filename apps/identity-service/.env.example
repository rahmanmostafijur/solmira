# Copy to .env for local development (loaded by `pnpm dev`). Values match docker-compose.yml defaults.
# Then run `pnpm --filter @solmira/identity-service keys:generate` to add a signing key pair.
NODE_ENV=development
PORT=4001
LOG_LEVEL=info
LOG_PRETTY=true

# Runtime role: DML only, subject to Row Level Security.
DATABASE_URL=postgres://identity_app:solmira_service_dev_password@localhost:5433/solmira_identity
# Owner role: used only by `pnpm db:migrate`.
MIGRATION_DATABASE_URL=postgres://identity_owner:solmira_service_dev_password@localhost:5433/solmira_identity
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://solmira:solmira_dev_password@localhost:5672

APP_URL=http://localhost:8080
SMTP_URL=smtp://localhost:2525

# Filled in by keys:generate. Never commit real keys.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
