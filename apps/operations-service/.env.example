# Copy to .env for local development (loaded by `pnpm dev`). Values match docker-compose.yml defaults.
NODE_ENV=development
PORT=4002
LOG_LEVEL=info
LOG_PRETTY=true

# Runtime role: subject to row-level security. Migrations use the separate schema owner below.
DATABASE_URL=postgres://operations_app:solmira_service_dev_password@localhost:5433/solmira_operations
MIGRATION_DATABASE_URL=postgres://operations_owner:solmira_service_dev_password@localhost:5433/solmira_operations
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://solmira:solmira_dev_password@localhost:5672

# Access tokens are issued by identity-service and verified here with its public JWKS only.
IDENTITY_JWKS_URL=http://localhost:4001/api/v1/auth/.well-known/jwks.json
# Used to confirm warehouse managers are active members, forwarding the caller's own token.
IDENTITY_INTERNAL_URL=http://localhost:4001
JWT_ISSUER=solmira-identity
JWT_AUDIENCE=solmira-api
ACCESS_TOKEN_TTL_SECONDS=900

# Product media: MinIO locally, Amazon S3 in deployed environments (there, leave S3_ENDPOINT and
# the static keys unset so the SDK uses the task role).
S3_BUCKET=solmira-media
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=  # host browsers use for signed URLs, when it differs from S3_ENDPOINT
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=solmira
S3_SECRET_ACCESS_KEY=solmira_dev_minio_password
IMAGE_URL_TTL_SECONDS=300
