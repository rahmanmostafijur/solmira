{
  "name": "@solmira/attempt-history",
  "version": "0.1.0",
  "private": true,
  "description": "Delivery attempt history in DynamoDB (ADR-0032): written by the dispatcher, read by the API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1154.0",
    "@aws-sdk/lib-dynamodb": "^3.1154.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^5.0.2"
  }
}
